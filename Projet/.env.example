# Copier ce fichier sous le nom .env (dans le dossier Projet), puis le remplir.
# Le fichier .env n'est jamais envoyé sur GitHub.

# Clé d'API Gemini (Google AI Studio). Vide : l'IA simulée est utilisée.
GEMINI_API_KEY=

# Modèle Gemini à utiliser (vérifier les modèles offerts dans Google AI Studio).
GEMINI_MODELE=gemini-2.5-flash

# Forcer l'IA : gemini ou simulee. Vide : gemini si une clé est présente.
IA_MODE=

# Pause entre deux appels pendant l'évaluation (niveau gratuit), en millisecondes.
GEMINI_DELAI_MS=4000

# Port du serveur.
PORT=3100
